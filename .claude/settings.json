{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(make test)",
      "Bash(make qa)",
      "Bash(make stan)",
      "Bash(make cs)",
      "Bash(make cs-fix)",
      "Bash(make deptrac)",
      "Bash(make audit)",
      "Bash(make mutation)",
      "Bash(make up)",
      "Bash(docker compose exec -T app vendor/bin/phpunit *)",
      "Bash(docker compose exec -T app vendor/bin/phpstan *)",
      "Bash(docker compose exec -T app vendor/bin/php-cs-fixer *)",
      "Bash(docker compose exec -T app php bin/console debug:*)",
      "Bash(docker compose exec -T app php bin/console lint:*)",
      "Bash(docker compose ps)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git worktree *)"
    ],
    "ask": [
      "Edit(./deptrac.yaml)",
      "Edit(./phpstan.neon)",
      "Edit(./infection.json5)",
      "Edit(./.php-cs-fixer.dist.php)",
      "Edit(./phpunit.dist.xml)",
      "Edit(./.github/**)",
      "Edit(./migrations/**)",
      "Edit(./CLAUDE.md)",
      "Bash(composer require *)",
      "Bash(composer remove *)",
      "Bash(docker compose exec -T app composer require *)",
      "Bash(docker compose exec -T app composer remove *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git clean *)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Bash(git push *)",
      "Bash(make down)",
      "Bash(make db-reset)",
      "Bash(docker compose down *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/garde-commandes.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/garde-invariants.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/qualite-fichier.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/barriere-fin-de-tour.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
